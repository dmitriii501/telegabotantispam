TELEGRAM_BOT_TOKEN=
TYPESAFE_API_KEY=
# optional
JEV_MODEL=jev-latest
DB_PATH=bot.db
LOG_LEVEL=INFO
# Your own Telegram id: the health check writes here when the bot goes down (write /start to the bot first)
ALERT_CHAT_ID=
# Web panel (Telegram Mini App). Leave WEBAPP_URL empty to disable it.
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Hour (UTC) of the daily digest and the daily cleanup; 6 = 09:00 Moscow
DIGEST_HOUR_UTC=6
# Comment texts and author names are deleted from the log after this many days
RETENTION_DAYS=30
