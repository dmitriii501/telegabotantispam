TELEGRAM_BOT_TOKEN=
TYPESAFE_API_KEY=
# optional
JEV_MODEL=jev-latest
DB_PATH=bot.db
LOG_LEVEL=INFO
# Your own Telegram id: the health check writes here when the bot goes down (write /start to the bot first)
ALERT_CHAT_ID=
# Selling: the people who may use /grant, /refund, /revenue (comma separated Telegram ids; defaults to ALERT_CHAT_ID)
OPERATOR_IDS=
# Who customers write to about payments (shown by /paysupport), for example @yourname
SUPPORT_CONTACT=
# Prices in Telegram Stars per 30 days, AI-read comments per 30 days, free trial (all optional)
PRICE_START=399
PRICE_PRO=990
CHECKS_START=20000
CHECKS_PRO=100000
CHECKS_TRIAL=10000
TRIAL_DAYS=14
# Web panel (Telegram Mini App). Leave WEBAPP_URL empty to disable it.
WEBAPP_URL=
WEBAPP_HOST=127.0.0.1
WEBAPP_PORT=8080
# Hour (UTC) of the daily digest and the daily cleanup; 6 = 09:00 Moscow
DIGEST_HOUR_UTC=6
# Comment texts and author names are deleted from the log after this many days
RETENTION_DAYS=30
